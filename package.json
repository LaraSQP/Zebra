{
	"name": "zebra",
	"displayName": "Zebra",
	"author": "LaraSQP",
	"publisher": "LaraSQP",
	"description": "Colorize vsCode folders, files, and editor tabs",
	"version": "0.2.1",
	"icon": "images/zebra-icon.png",
	"license": "MIT",
	"main": "./out/extension.js",
	"engines": {
		"vscode": "^1.145.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"devDependencies": {
		"@types/vscode": "^1.145.0",
		"@vscode/vsce": "^4.1.0",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"generate": "node scripts/GenerateColors.mjs",
		"compile": "tsc -p ./",
		"package": "npm run generate && npm run compile && vsce package --out ./..out/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/LaraSQP/Zebra.git"
	},
	"contributes": {
		"commands": [
			{
				"command": "zebra.copyFilename",
				"title": "Copy Filename"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "zebra.copyFilename",
					"when": "resourceScheme == file",
					"group": "6_copypath"
				}
			],
			"editor/title/context": [
				{
					"command": "zebra.copyFilename",
					"group": "1_cutcopypaste"
				}
			]
		},
		"configuration": {
			"title": "Zebra",
			"properties": {
				"zebra.colors": {
					"type": "object",
					"default": {},
					"description": "Folder names and their assigned colors",
					"additionalProperties": {
						"type": "string",
						"pattern": "^(#[0-9A-Fa-f]{6}|zebra\\.color([1-9]|[12][0-9]|3[0-2]))$"
					}
				}
			}
		},

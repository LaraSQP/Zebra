{
	"zebra.colors": {
		".vscode": "zebra.color1",
		"node_modules/.bin": "zebra.color2",
		"src": "zebra.color3"
	},
	"workbench.colorCustomizations": {
		"zebra.color1": "#8cb4d5",
		"zebra.color2": "#9cb15f",
		"zebra.color3": "#C17A36"
	},
	"cSpell.words": ["vscodeignore"],
	"[typescript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[javascript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"js/ts.format.enabled": true,
	"js/ts.format.insertSpaceAfterCommaDelimiter": true,
	"js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,
	"js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBrackets": true,
	"js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyParenthesis": true,
	"js/ts.format.insertSpaceBeforeAndAfterBinaryOperators": true,
	"js/ts.format.placeOpenBraceOnNewLineForFunctions": true,
	"js/ts.format.placeOpenBraceOnNewLineForControlBlocks": true,
	"js/ts.format.semicolons": "insert",
	"js/ts.format.insertSpaceAfterSemicolonInForStatements": true,
	"js/ts.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
	"js/ts.format.indentSwitchCase": true
}

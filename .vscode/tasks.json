{
	"version": "2.0.0",
	"tasks": [
		{
			// Give the task a recognizable name
			"label": "Compile Zebra",

			// Run this as a shell command
			"type": "shell",
			"command": "npm.cmd",

			// Equivalent to running npm.cmd run compile
			"args": ["run", "compile"],

			// Mark this as the default build task
			"group": {
				"kind": "build",
				"isDefault": true
			},

			// Allow vsCode to recognize TypeScript compiler errors
			"problemMatcher": "$tsc"
		}
	]
}
